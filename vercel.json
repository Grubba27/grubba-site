{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "redirects": [
    {
      "source": "/favicon.ico",
      "has": [{ "type": "host", "value": "brutalist.grubba.dev" }],
      "destination": "/icons/brutalist.png",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "deactivated.grubba.dev" }],
      "destination": "/deactivated.html"
    },
    { "source": "/deactivated", "destination": "/deactivated.html" },
    { "source": "/(.*)", "destination": "/site.html" }
  ]
}
